{
  "name": "cic-technology",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint src/app src/server src/shared/components src/shared/tokens src/shared/ui src/instrumentation.ts scripts/check-foundation-env.ts next.config.ts postcss.config.mjs --max-warnings=0",
    "typecheck": "npm run typecheck:foundation && npm run typecheck:legacy",
    "typecheck:foundation": "tsc --noEmit -p tsconfig.json",
    "typecheck:legacy": "tsc --noEmit -p tsconfig.legacy.json",
    "check:env": "node --experimental-strip-types scripts/check-foundation-env.ts",
    "dev:legacy": "vite --port=3001 --host=0.0.0.0",
    "build:legacy": "vite build",
    "preview:legacy": "vite preview",
    "check:cms-production": "node scripts/check-cms-production.mjs"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ckeditor5": "^48.4.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.3",
    "postgres": "^3.4.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
