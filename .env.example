# Public application URL (no trailing slash)
APP_URL=http://localhost:3000

# Supabase project values safe to expose. They are used by request-aware server/session clients;
# do not create a browser client until an approved realtime/direct Storage use case exists.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Leave empty until an approved admin use-case needs it.
# Never expose with NEXT_PUBLIC_ or commit real values to Git.
SUPABASE_SERVICE_ROLE_KEY=

# One-time/idempotent CMS administrator bootstrap. Never commit a real password.
CMS_BOOTSTRAP_ADMIN_EMAIL=admin@cic.com.vn
CMS_BOOTSTRAP_ADMIN_PASSWORD=
CMS_BOOTSTRAP_ADMIN_ROTATE_PASSWORD=false

# Server-only pooled PostgreSQL URL for short transactions. Use a least-privileged application
# role and Supabase transaction pooler in production; never use this value in browser code.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# AI Co-pilot Integration (Server-only). Used by CMS AI Assistant for automated catalog content & SEO.
# Option A: Gemini direct API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Option B: Custom AI Operator (Qwen / Local / Self-hosted proxy)
AI_PROVIDER=gemini
AI_OPERATOR_API_URL=
AI_OPERATOR_API_KEY=
AI_OPERATOR_MODEL=qwen-30b
AI_OPERATOR_TIMEOUT_MS=30000

# SMTP Email Configuration (Server-only). Used for customer lead notifications and form receipts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME="CIC Technology & Consultancy"
MAIL_FROM_ADDRESS="noreply@cic.com.vn"
ADMIN_NOTIFICATION_EMAIL="info@cic.com.vn"

# Google Sheets Integration (Server-only). Used by Dynamic Form Multi-Destination engine.
# 1. Create a Google Cloud Project & Service Account in Google Cloud Console.
# 2. Grant Google Sheets API permissions.
# 3. Place Service Account JSON Key in root (e.g. ggsheet-*.json) or configure path/keys below:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Local legacy ETL only. Keep real source/destination credentials outside Git.
DB_MIGRATE_MYSQL_HOST=
DB_MIGRATE_MYSQL_PORT=3306
DB_MIGRATE_MYSQL_USER=
DB_MIGRATE_MYSQL_PASSWORD=
DB_MIGRATE_MYSQL_DATABASE=
DB_MIGRATE_POSTGRES_HOST=
DB_MIGRATE_POSTGRES_PORT=5432
DB_MIGRATE_POSTGRES_USER=
DB_MIGRATE_POSTGRES_PASSWORD=
DB_MIGRATE_POSTGRES_DATABASE=
DB_MIGRATE_MANIFEST_PATH=manifest.json
