# Public application URL (no trailing slash)
APP_URL=http://localhost:3000

# Supabase project values safe for browser use when a browser client is added.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Leave empty until an approved admin use-case needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional pooled PostgreSQL URL for future server-only direct SQL tooling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Legacy integration retained as an example only; never expose with NEXT_PUBLIC_.
GEMINI_API_KEY=
